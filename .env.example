# Apple iCloud credentials
ICLOUD_USERNAME=your-apple-id@example.com
# Password can be stored here or in system keyring (recommended)
# ICLOUD_PASSWORD=your-password

# Backend selection: pyicloud (default) or rustpush
LOCATION_BACKEND=pyicloud

# Polling configuration
POLL_MIN_INTERVAL=7
POLL_MAX_INTERVAL=10

# Database path (default: ./data/locations.db)
DATABASE_PATH=./data/locations.db

# Web server
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Optional rustpush bridge backend
RUSTPUSH_BRIDGE_BIN=./rustpush_bridge/target/release/find-my-rustpush-bridge
RUSTPUSH_STATE_DIR=${HOME}/.find-my-timeline/rustpush
# Path to validation data used during rustpush bootstrap (first run)
# RUSTPUSH_VALIDATION_DATA_PATH=/path/to/validation-data.bin
# Optional: delegate bridge commands to an external runtime bridge binary
# RUSTPUSH_BRIDGE_DELEGATE=/path/to/runtime/find-my-rustpush-bridge
RUSTPUSH_SYNC_TIMEOUT_SEC=120

# APS mode for rustpush: APS payloads trigger extra fast refresh polling
RUSTPUSH_APS_ENABLED=true
RUSTPUSH_APS_REFRESH_INTERVAL_SEC=5
